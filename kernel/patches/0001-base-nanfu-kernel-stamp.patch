+// found in the LICENSE file.
+
+#ifndef BASE_NANFU_KERNEL_STAMP_H_
+#define BASE_NANFU_KERNEL_STAMP_H_
+
+#include <string_view>
+
+namespace base::nanfu {
+
+// The upstream Chromium tag this series is written against. Changing it needs
+// the whole series re-verified by kernel/verify-patches.sh against the new tag;
+// a patch never bumps this on its own.
+inline constexpr char kUpstreamTag[] = "155.0.8059.85";
+
+// Identifies the series, not a build. Bump when a patch is added or dropped, so
+// a shipped binary names the exact series it was built from.
+inline constexpr int kSeriesRevision = 1;
+
+// A string stock Chromium does not contain. Once a wiring patch includes this
+// header in a compiled target, a build is checked with
+//   strings -a chrome | grep nanfu-kernel-series
+// Nothing in this series exposes it to page script.
+inline constexpr char kKernelStamp[] =
+    "nanfu-kernel-series:1;upstream=155.0.8059.85";
+
+}  // namespace base::nanfu
+
+#endif  // BASE_NANFU_KERNEL_STAMP_H_
