 namespace {
 
+// Fingerprint hardening: lets the launcher pin the vendor/renderer strings
+// exposed by WebGL, including WEBGL_debug_renderer_info's UNMASKED_* queries.
+// Without the switches the upstream strings are returned unchanged.
+String FingerprintWebGLString(const char* switch_name,
+                              const String& fallback) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switch_name)) {
+    return fallback;
+  }
+  return String::FromUTF8(command_line->GetSwitchValueASCII(switch_name));
+}
+
 enum class WebGLANGLEImplementation {
   // These values are persisted to logs. Entries should not be renumbered and
   // numeric values should never be reused.
