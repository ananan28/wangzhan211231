+// Fingerprint hardening: returns a deterministic sub-pixel offset derived from
+// the process seed, the node id and the axis, or 0 when the feature is off.
+// Bounded to +/-0.5 CSS px (amplitude is capped at 1.0) so that hit-testing
+// and layout-adjacent APIs remain usable.
+float FingerprintRectJitter(Element& element, int axis) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(
+          blink::switches::kFingerprintClientRectsJitter)) {
+    return 0.0f;
+  }
+  double amplitude = 0.0;
+  if (!base::StringToDouble(
+          command_line->GetSwitchValueASCII(
+              blink::switches::kFingerprintClientRectsJitter),
+          &amplitude) ||
+      amplitude <= 0.0) {
+    return 0.0f;
+  }
+  amplitude = std::min(amplitude, 1.0);
+
+  uint32_t seed = 0;
+  base::StringToUint(
+      command_line->GetSwitchValueASCII(blink::switches::kFingerprintSeed),
+      &seed);
+
+  uint32_t hash = seed ^ (static_cast<uint32_t>(element.GetDomNodeId()) *
+                          0x9e3779b9u) ^
+                  (static_cast<uint32_t>(axis) * 0x85ebca6bu);
+  hash ^= hash >> 16;
+  hash *= 0x7feb352du;
+  hash ^= hash >> 15;
+  const double unit = static_cast<double>(hash) / 4294967296.0 - 0.5;
+  return static_cast<float>(unit * amplitude);
+}
